<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopClient\ShopClient.csproj" />
    <ProjectReference Include="..\WebContracts\WebContracts.csproj" />
    <ProjectReference Include="..\WebCore\WebCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Core\Price\Components\PriceViewer.razor" />
    <_ContentIncludedByDefault Remove="Core\Product\Components\ProductCard.razor" />
    <_ContentIncludedByDefault Remove="Core\Product\Components\ProductDetails.razor" />
    <_ContentIncludedByDefault Remove="Core\Product\Pages\Product.razor" />
    <_ContentIncludedByDefault Remove="Core\Product\Pages\Products.razor" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Components\Pages\Price\Components\PriceViewer.razor" />
    <AdditionalFiles Include="Components\Pages\ProductAiSearch\Pages\Search.razor" />
    <AdditionalFiles Include="Components\Pages\Product\Components\ProductCard.razor" />
    <AdditionalFiles Include="Components\Pages\Product\Components\ProductDetails.razor" />
    <AdditionalFiles Include="Components\Pages\Product\Pages\Product.razor" />
    <AdditionalFiles Include="Components\Pages\Product\Pages\Products.razor" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Core\" />
  </ItemGroup>

</Project>
